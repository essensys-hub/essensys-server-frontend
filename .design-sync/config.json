{
  "projectId": "cad6f3ac-64df-4491-bbef-5dec0cfbfc59",
  "shape": "package",
  "pkg": "essensys-web-react",
  "globalName": "EssensysDS",
  "srcDir": "src",
  "tsconfig": "tsconfig.app.json",
  "buildCmd": "npm run build && cp dist/assets/index-*.css .design-sync/compiled.css",
  "cssEntry": ".design-sync/compiled.css",
  "readmeHeader": ".design-sync/conventions.md",
  "entry": ".design-sync/lib-entry.tsx",
  "provider": { "component": "PreviewRoot" },
  "runtimeFontPrefixes": ["Arial Narrow", "Antonio", "Impact", "Lucida Grande", "Lucida Sans Unicode"],
  "overrides": {
    "MobileDrawer": { "cardMode": "single", "viewport": "420x760" },
    "MobileHeader": { "cardMode": "single", "viewport": "480x260" },
    "BottomTabs": { "cardMode": "single", "viewport": "480x600" },
    "SidebarMenu": { "cardMode": "single", "viewport": "1080x760" },
    "Header": { "cardMode": "column", "viewport": "1080x320" },
    "ScenarioEditorDrawer": { "cardMode": "single", "viewport": "680x760" },
    "Layout": { "cardMode": "single", "viewport": "1100x760" }
  },
  "componentSrcMap": {
    "ActionButton": "src/components/UI/ActionButton.tsx",
    "CardSummary": "src/components/UI/CardSummary.tsx",
    "ControlCard": "src/components/UI/ControlCard.tsx",
    "PageHeader": "src/components/UI/PageHeader.tsx",
    "AlarmControl": "src/components/Dashboard/AlarmControl.tsx",
    "BackendConfig": "src/components/Dashboard/BackendConfig.tsx",
    "HeatingControl": "src/components/Dashboard/HeatingControl.tsx",
    "LightingControl": "src/components/Dashboard/LightingControl.tsx",
    "NotificationControl": "src/components/Dashboard/NotificationControl.tsx",
    "ShutterControl": "src/components/Dashboard/ShutterControl.tsx",
    "SprinklerControl": "src/components/Dashboard/SprinklerControl.tsx",
    "WaterHeaterControl": "src/components/Dashboard/WaterHeaterControl.tsx",
    "HeatingScheduleGrid": "src/components/Heating/HeatingScheduleGrid.tsx",
    "InjectionSaveConsole": "src/components/Heating/InjectionSaveConsole.tsx",
    "Header": "src/components/Layout/Header.tsx",
    "Layout": "src/components/Layout/Layout.tsx",
    "BottomTabs": "src/components/Navigation/BottomTabs.tsx",
    "MobileDrawer": "src/components/Navigation/MobileDrawer.tsx",
    "MobileHeader": "src/components/Navigation/MobileHeader.tsx",
    "SidebarMenu": "src/components/Navigation/SidebarMenu.tsx",
    "ScenarioButtonGrid": "src/components/Scenarios/ScenarioButtonGrid.tsx",
    "ScenarioEditorDrawer": "src/components/Scenarios/ScenarioEditorDrawer.tsx",
    "SyncSettingsPanel": "src/components/Settings/SyncSettingsPanel.tsx",
    "CameraCard": "src/components/UniFi/CameraCard.tsx"
  }
}
